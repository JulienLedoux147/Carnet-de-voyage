<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= titre %> | Carnet de voyage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include("partials/navbar", { pageActive: "statistiques" }) %>

    <%# Accessibilité : tabindex="-1" permet au lien d’évitement de déplacer le focus vers le contenu. %>
    <main id="contenu-principal" class="section app-main" tabindex="-1">
      <div class="container">
        <h1 class="title"><%= titre %></h1>
        <p class="subtitle">Un aperçu de vos voyages et de vos projets.</p>

        <% if (resume.total === 0) { %>
          <section class="box empty-state" aria-labelledby="statistiques-vides">
            <h2 class="title is-4" id="statistiques-vides">Le carnet est vide</h2>
            <p class="mb-4">Ajoutez un premier pays pour afficher des statistiques.</p>
            <a class="button is-link" href="/pays/nouveau">Ajouter un pays</a>
          </section>
        <% } else { %>
          <section class="stats-grid mb-6" aria-label="Résumé du carnet">
            <article class="stat-card">
              <p class="stat-label">Pays dans le carnet</p>
              <p class="stat-value"><%= resume.total %></p>
            </article>
            <article class="stat-card">
              <p class="stat-label">Pays visités</p>
              <p class="stat-value"><%= resume.visites %></p>
            </article>
            <article class="stat-card">
              <p class="stat-label">Pays à visiter</p>
              <p class="stat-value"><%= resume.aVisiter %></p>
            </article>
            <article class="stat-card">
              <p class="stat-label">Note moyenne</p>
              <p class="stat-value">
                <%= resume.noteMoyenne === null ? "Aucune note" : `${resume.noteMoyenne.toLocaleString("fr-CA", { maximumFractionDigits: 1 })} sur 5` %>
              </p>
            </article>
          </section>

          <section class="box mb-6" aria-labelledby="population-visitee">
            <h2 class="title is-4" id="population-visitee">Population des pays visités</h2>
            <p class="stat-highlight">
              <%= resume.populationVisitee.toLocaleString("fr-CA") %>
              <span>personnes</span>
            </p>
            <p class="help">Somme des populations officielles enregistrées dans le carnet.</p>
          </section>

          <section class="box" aria-labelledby="repartition-regions">
            <h2 class="title is-4" id="repartition-regions">Répartition par région</h2>

            <div class="table-container">
              <table class="table is-fullwidth">
                <%# Accessibilité : la légende et les en-têtes aident à se repérer en lisant le tableau. %>
                <caption class="is-sr-only">Nombre et pourcentage de pays par région</caption>
                <thead>
                  <tr>
                    <th scope="col">Région</th>
                    <th scope="col">Nombre de pays</th>
                    <th scope="col">Part du carnet</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const region of regions) { %>
                    <tr>
                      <th scope="row"><%= region.nom %></th>
                      <td><%= region.nombre %></td>
                      <td>
                        <%# Accessibilité : le pourcentage est lu en texte. La barre visuelle est ignorée pour éviter une répétition. %>
                        <progress
                          class="progress is-link mb-1"
                          aria-hidden="true"
                          value="<%= region.nombre %>"
                          max="<%= resume.total %>"
                        ><%= region.pourcentage %>%</progress>
                        <span class="is-size-7"><%= region.pourcentage %>%</span>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </section>

          <section class="box" aria-labelledby="Conseiller IA">
            <div class="is-flex is-align-items-center is-flex-wrap-wrap"></div>
              <h2 class="title is-4 mb-0 mr-4" id="titre-IA" id="IA">Conseiller IA</h2>
              <p class="has-text-grey">
                  Découvrez de nouvelles destinations grâce à des recommandations
                  personnalisées selon vos voyages et vos notes.
              </p>
              <button
                class="button is-light mt-5"
                type="button"
                id="bouton-IA"
                aria-pressed="false"
              >
                <span>Générer des recommandations</span>
              </button>
            </>

            <div id="recommandations-IA" class="mt-5" aria-live="polite">
                <!-- Les recommandations de l'IA seront affichées ici -->
            </div>

          </section>
        <% } %>
      </div>
    </main>

    <script src="/js/navbar.js"></script>
    <script src="/js/statistiques.js"></script>
  </body>
</html>
