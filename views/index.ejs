<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= titre %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <%- include("partials/navbar", { pageActive: "accueil" }) %>

    <%# Accessibilité : tabindex="-1" permet au lien d’évitement de déplacer le focus vers le contenu. %>
    <main id="contenu-principal" class="section app-main" tabindex="-1">
      <div class="container">
        <% if (messageSucces) { %>
          <div class="notification is-success" role="status">
            <%= messageSucces %>
          </div>
        <% } %>

        <div class="is-flex is-justify-content-space-between is-align-items-center mb-5">
          <div>
            <h1 class="title"><%= titre %></h1>
            <p class="subtitle"><%= pays.length %> pays affiché<%= pays.length > 1 ? "s" : "" %></p>
          </div>
          <a class="button is-link" href="/pays/nouveau">Ajouter un pays</a>
        </div>

        <%# Accessibilité : le lecteur d’écran peut atteindre directement la zone de recherche. %>
        <form class="box" method="get" action="/" role="search" aria-label="Rechercher dans le carnet">
          <div class="columns is-align-items-flex-end">
            <div class="column">
              <label class="label" for="q">Rechercher</label>
              <div class="control">
                <input
                  class="input"
                  id="q"
                  name="q"
                  type="search"
                  value="<%= filtres.q %>"
                  placeholder="Nom ou code CCA3"
                >
              </div>
            </div>

            <div class="column is-one-quarter">
              <label class="label" for="statut">Statut</label>
              <div class="select is-fullwidth">
                <select id="statut" name="statut">
                  <option value="">Tous les pays</option>
                  <option value="visite" <%= filtres.statut === "visite" ? "selected" : "" %>>Visités</option>
                  <option value="a_visiter" <%= filtres.statut === "a_visiter" ? "selected" : "" %>>À visiter</option>
                </select>
              </div>
            </div>

            <div class="column is-narrow">
              <button class="button is-link" type="submit">Filtrer</button>
              <% if (filtres.q || filtres.statut) { %>
                <a class="button is-light" href="/">Réinitialiser</a>
              <% } %>
            </div>
          </div>
        </form>

        <% if (pays.length === 0) { %>
          <section class="box empty-state" aria-labelledby="aucun-pays">
            <h2 class="title is-4" id="aucun-pays">Aucun pays trouvé</h2>
            <p class="mb-4">
              <%= filtres.q || filtres.statut
                ? "Modifiez les critères de recherche ou réinitialisez les filtres."
                : "Commencez votre carnet en ajoutant votre premier pays." %>
            </p>
            <% if (!filtres.q && !filtres.statut) { %>
              <a class="button is-link" href="/pays/nouveau">Ajouter un pays</a>
            <% } %>
          </section>
        <% } else { %>
          <div class="table-container">
            <table class="table is-fullwidth is-hoverable">
              <%# Accessibilité : la légende nomme le tableau et scope relie chaque cellule à ses en-têtes. %>
              <caption class="is-sr-only">Résultats du carnet de voyage</caption>
              <thead>
                <tr>
                  <th scope="col">Pays</th>
                  <th scope="col">Région</th>
                  <th scope="col">Statut</th>
                  <th scope="col">Note</th>
                  <th scope="col"><span class="is-sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% for (const item of pays) { %>
                  <tr>
                    <th scope="row">
                      <div class="is-flex is-align-items-center">
                        <% if (item.drapeau_url) { %>
                          <%# Accessibilité : alt="" évite de répéter le nom du pays affiché à côté du drapeau. %>
                          <img
                            class="country-flag mr-4"
                            src="<%= item.drapeau_url %>"
                            alt=""
                            loading="lazy"
                          >
                        <% } %>
                        <div>
                          <strong><%= item.nom %></strong>
                          <div class="is-size-7 has-text-grey"><%= item.code_cca3 %></div>
                        </div>
                      </div>
                    </th>
                    <td><%= item.region || "—" %></td>
                    <td>
                      <span class="tag <%= item.statut === 'visite' ? 'is-success' : 'is-info' %>">
                        <%= item.statut === "visite" ? "Visité" : "À visiter" %>
                      </span>
                    </td>
                    <td><%= item.note ? `${item.note} sur 5` : "Non noté" %></td>
                    <td class="has-text-right">
                      <a class="button is-small is-link is-light" href="/pays/<%= item.id %>">
                        Voir la fiche de <%= item.nom %>
                      </a>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </main>

    <script src="/js/navbar.js"></script>
  </body>
</html>
